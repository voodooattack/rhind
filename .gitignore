# devenv
.devenv*
devenv.local.nix
devenv.local.yaml
.env

# python
**/__pycache__/**
*.egg-info
dist/
.venv/
.pytest_cache

# pre-commit (generated by devenv)
.pre-commit-config.yaml

# proof metrics ledger: per-run sidecars are local; the ledger itself
# (.ledger/index.jsonl, appended by the pre-commit hook) IS tracked, one
# line per commit recording which proofs were re-run and why (hash tiers).
# Reports and their data files are tracked too: the report is the receipt,
# the data file is what documents are built from.
/.ledger/*.json
/.ledger/**/*.json
!/.ledger/index.jsonl

# compiled paper (rebuild with rhind_paper)
papers/**/*.pdf
